# Copy this file to keystore.properties (ignored by version control) and fill it in to sign the
# release APK. Alternatively set the environment variables TAHADHARI_KEYSTORE_FILE,
# TAHADHARI_KEYSTORE_PASSWORD, TAHADHARI_KEY_ALIAS and TAHADHARI_KEY_PASSWORD.
#
# Without either, `:composeApp:assembleRelease` still succeeds but signs with the debug key
# (a Gradle warning says so). Never commit the keystore or this file with real values.
#
# Create a keystore once with:
#   keytool -genkeypair -v -keystore tahadhari-release.jks -alias tahadhari \
#           -keyalg RSA -keysize 4096 -validity 10000
storeFile=tahadhari-release.jks
storePassword=change-me
keyAlias=tahadhari
keyPassword=change-me
